{
  "name": "@deepseek-code/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:sidecar && tauri dev",
    "build": "npm run prepare:sidecar && npm run prepare:browser && tauri build",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build:web": "tsc -b && vite build",
    "prepare:sidecar": "bash ../../scripts/build-agent-sidecar.sh",
    "prepare:browser": "bash ../../scripts/prepare-browser-runtime.sh",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "highlight.js": "^11.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
